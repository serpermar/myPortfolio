---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { title, summary, year, context, stack, repo, demo, cover } = project.data;
const href = `/proyectos/${project.id}`;

const widths = wide ? [720, 1120, 1440] : [480, 960];
const sizes = wide
  ? '(max-width: 1120px) 100vw, 1120px'
  : '(max-width: 760px) 100vw, 50vw';
---

<article class="card reveal">
  <a class="card-media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={cover}
      alt=""
      widths={widths}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
    <span class="card-badge">{context}</span>
  </a>

  <div class="card-body">
    <div class="card-top">
      <h3 class="card-title"><a href={href}>{title}</a></h3>
      <span class="card-year">{year}</span>
    </div>

    <p class="card-summary">{summary}</p>

    <ul class="tags">
      {stack.map((tech) => (
        <li>{tech}</li>
      ))}
    </ul>

    <div class="card-links">
      <a href={href}>Caso →</a>
      {demo && (
        <a href={demo} target="_blank" rel="noopener">Demo ↗</a>
      )}
      {repo && (
        <a href={repo} target="_blank" rel="noopener">Código ↗</a>
      )}
      {!demo && !repo && (
        <span class="is-disabled" title="Aún sin enlace público">Sin enlace público</span>
      )}
    </div>
  </div>
</article>
