---
import { site } from '../data/site';

const hasForm = Boolean(site.web3formsKey);
---

<section id="contacto" class="section">
  <div class="container">
    <div class="contact-grid">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2 class="contact-title">
          ¿Hablamos?{' '}
          <span class="serif" style="display:block">Tengo hueco.</span>
        </h2>
        <p class="contact-lead">
          Si buscas a alguien para un equipo, tienes un proyecto en mente o
          simplemente quieres comentar algo del código, escríbeme. Respondo en
          menos de 24 horas.
        </p>

        <a class="email-link" href={`mailto:${site.email}`}>
          {site.email}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8"></path>
          </svg>
        </a>

        <ul class="social-row">
          <li><a href={site.github} target="_blank" rel="noopener">GitHub</a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={site.cvPdf} download>CV en PDF</a></li>
        </ul>
      </div>

      {hasForm ? (
        <form
          class="form"
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value="Nuevo mensaje desde el portfolio" />
          <input type="hidden" name="from_name" value="Portfolio de Sergi Pérez Marí" />
          <input
            type="checkbox"
            name="botcheck"
            class="honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field">
            <label for="cf-name">Nombre</label>
            <input id="cf-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="cf-message">Mensaje</label>
            <textarea id="cf-message" name="message" required></textarea>
          </div>

          <button class="btn btn-primary" type="submit">Enviar mensaje</button>
          <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
        </form>
      ) : (
        <div class="form" style="align-content:start">
          <p class="mono" style="color:var(--fg-faint)">Directo, sin formularios</p>
          <p style="margin:0;color:var(--fg-muted);font-size:.95rem">
            Un email con el asunto claro llega antes que cualquier formulario. Si
            prefieres, también puedes escribirme por LinkedIn.
          </p>
          <a class="btn btn-primary" href={`mailto:${site.email}`} style="justify-content:center">
            {site.email}
          </a>
          <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener" style="justify-content:center">
            Mensaje por LinkedIn ↗
          </a>
          <p class="mono" style="color:var(--fg-faint);margin:0">
            Respuesta en menos de 24 h
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById('contact-form');
    if (!form) return;
    const status = document.getElementById('cf-status');
    const button = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !button) return;

      status.dataset.state = '';
      status.textContent = 'Enviando…';
      button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          status.dataset.state = 'ok';
          status.textContent = 'Mensaje enviado. Te respondo en menos de 24 horas.';
        } else {
          status.dataset.state = 'error';
          status.textContent = result.message || 'No se pudo enviar. Prueba con el email directo.';
        }
      } catch {
        status.dataset.state = 'error';
        status.textContent = 'Fallo de red. Prueba con el email directo.';
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>
