---
import { site } from '../data/site';
---

<section id="contacto" class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2 class="section-title">Hablemos</h2>
      </div>
      <p class="section-note">
        Cuéntame el proyecto o la vacante. Te respondo en menos de 48 h.
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <p>Si prefieres el email directo:</p>
        <a href={`mailto:${site.email}`} class="contact-email">{site.email}</a>
        <p class="contact-note">
          También estoy en <a href={site.linkedin}>LinkedIn</a> y
          <a href={site.github}>GitHub</a>.
        </p>
      </div>

      {site.web3formsKey ? (
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="contact-form"
          novalidate
        >
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value="Nuevo mensaje desde el portafolio" />
          <input type="hidden" name="from_name" value="Portfolio Sergi Pérez" />
          <input
            type="checkbox"
            name="botcheck"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <label>
            <span>Nombre</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>

          <label>
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label>
            <span>Mensaje</span>
            <textarea name="message" required rows="5" autocomplete="off"></textarea>
          </label>

          <button type="submit" class="btn">Enviar mensaje</button>

          <p id="form-status" role="status" aria-live="polite" class="form-status"></p>
        </form>
      ) : (
        <p class="contact-note">
          El formulario está desactivado temporalmente. Escríbeme al email de arriba.
        </p>
      )}
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    status.textContent = 'Enviando…';
    status.className = 'form-status';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });
      const json = await res.json();

      if (json.success) {
        form.reset();
        status.textContent = 'Mensaje enviado. Te respondo en menos de 48 h.';
        status.classList.add('is-success');
      } else {
        status.textContent =
          'Algo ha fallado. Escríbeme directamente al email de la izquierda.';
        status.classList.add('is-error');
      }
    } catch {
      status.textContent =
        'Error de red. Revisa tu conexión o escríbeme por email.';
      status.classList.add('is-error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact-grid { display: grid; gap: 2rem; }
  @media (min-width: 768px) {
    .contact-grid { grid-template-columns: 1fr 1.5fr; }
  }
  .contact-email { font-weight: 600; word-break: break-all; }
  .contact-form { display: grid; gap: 1rem; }
  .contact-form label { display: grid; gap: 0.35rem; font-size: 0.9rem; }
  .contact-form input,
  .contact-form textarea {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border, #ccc);
    border-radius: 6px;
    font: inherit;
    background: var(--bg, #fff);
    color: inherit;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--accent, #4f46e5);
    outline-offset: 1px;
  }
  .contact-form button[disabled] { opacity: 0.6; cursor: wait; }
  .form-status { min-height: 1.2em; font-size: 0.9rem; }
  .form-status.is-success { color: #16a34a; }
  .form-status.is-error { color: #dc2626; }
</style>