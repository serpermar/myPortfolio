---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, index) => {
    const next = sorted[(index + 1) % sorted.length] ?? null;
    return {
      params: { slug: project.id },
      props: { project, next },
    };
  });
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const {
  title,
  summary,
  description,
  role,
  year,
  context,
  stack,
  demo,
  repo,
  cover,
  gallery,
  highlights,
} = project.data;

const metaDescription = description ?? summary;

// Carga todas las imágenes de proyectos una sola vez en build
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/**/*.{webp,jpg,jpeg,png,avif}',
  { eager: true }
);

// Resuelve un nombre de archivo a ImageMetadata, tolerando rutas antiguas
function resolveImage(name: string | undefined) {
  if (!name) return undefined;
  if (name.startsWith('/src/assets/projects/')) {
    return images[name]?.default;
  }
  if (name.startsWith('/')) {
    const fileName = name.split('/').pop();
    return fileName
      ? images[`/src/assets/projects/${project.id}/${fileName}`]?.default
      : undefined;
  }
  return images[`/src/assets/projects/${project.id}/${name}`]?.default;
}

const coverImage = resolveImage(cover);
const galleryImages = (gallery ?? []).map((img) => ({
  alt: img.alt,
  module: resolveImage(img.src),
}));
---

<BaseLayout title={`${title} · Sergi Pérez`} description={metaDescription}>
  <!-- Hero -->
  <section class="project-hero">
    <div class="container">
      <a href="/#proyectos" class="back-link">← Volver a proyectos</a>
      <p class="eyebrow">{context} · {year}</p>
      <h1 class="project-title">{title}</h1>
      <p class="project-summary">{summary}</p>

      {highlights && highlights.length > 0 && (
        <ul class="project-highlights">
          {highlights.map((h) => <li>{h}</li>)}
        </ul>
      )}
    </div>
  </section>

  <!-- Layout de dos columnas -->
  <div class="container project-layout">
    <!-- Columna izquierda: contenido editorial -->
    <article class="project-content">
      {coverImage && (
        <Image
          src={coverImage}
          alt={`Portada de ${title}`}
          class="project-cover"
          loading="eager"
          widths={[800, 1200, 1600]}
          sizes="(min-width: 900px) 60vw, 100vw"
        />
      )}

      <div class="prose">
        <Content />
      </div>

      {galleryImages.length > 0 && (
        <section class="project-gallery">
          <h2 class="gallery-title">Galería</h2>
          <div class="gallery-grid">
            {galleryImages.map((img) =>
              img.module ? (
                <figure>
                  <Image
                    src={img.module}
                    alt={img.alt}
                    loading="lazy"
                    widths={[400, 800]}
                    sizes="(min-width: 640px) 50vw, 100vw"
                  />
                  {img.alt && <figcaption>{img.alt}</figcaption>}
                </figure>
              ) : null
            )}
          </div>
        </section>
      )}
    </article>

    <!-- Columna derecha: sidebar tipo Epic -->
    <aside class="project-sidebar">
      <div class="sidebar-block">
        <h2 class="sidebar-title">Stack</h2>
        <ul class="stack-list">
          {stack.map((tech) => <li>{tech}</li>)}
        </ul>
      </div>

      <div class="sidebar-block">
        <h2 class="sidebar-title">Detalles</h2>
        <dl class="details-list">
          <dt>Rol</dt>
          <dd>{role}</dd>
          <dt>Año</dt>
          <dd>{year}</dd>
          <dt>Contexto</dt>
          <dd>{context}</dd>
        </dl>
      </div>

      {(demo || repo) && (
        <div class="sidebar-actions">
          {demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Ver demo
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </a>
          )}
          {repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost"
            >
              Ver código
            </a>
          )}
        </div>
      )}
    </aside>
  </div>

  <!-- Siguiente proyecto -->
  {next && (
    <section class="next-project">
      <div class="container">
        <a href={`/proyectos/${next.id}`} class="next-project-link">
          <span class="next-label">Siguiente proyecto</span>
          <span class="next-title">{next.data.title} →</span>
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .project-hero {
    padding-block: 4rem 2rem;
    border-bottom: 1px solid var(--border, #e5e5e5);
  }
  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    color: var(--fg-muted, #666);
    text-decoration: none;
  }
  .back-link:hover { color: var(--fg, #111); }
  .project-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0.25rem 0 1rem;
  }
  .project-summary {
    font-size: 1.15rem;
    color: var(--fg-muted, #555);
    max-width: 60ch;
  }
  .project-highlights {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .project-highlights li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.95rem;
    color: var(--fg-muted, #555);
  }
  .project-highlights li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent, #4f46e5);
  }

  .project-layout {
    display: grid;
    gap: 3rem;
    padding-block: 3rem;
  }
  @media (min-width: 900px) {
    .project-layout {
      grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
      gap: 4rem;
      align-items: start;
    }
    .project-sidebar {
      position: sticky;
      top: 2rem;
    }
  }

  .project-cover {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.15rem;
  }
  .prose :global(p),
  .prose :global(ul) {
    line-height: 1.7;
  }

  .project-sidebar {
    display: grid;
    gap: 2rem;
    align-self: start;
  }
  .sidebar-block {
    display: grid;
    gap: 0.75rem;
  }
  .sidebar-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint, #888);
    margin: 0;
    font-weight: 600;
  }
  .stack-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .stack-list li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border, #ddd);
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .details-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.9rem;
  }
  .details-list dt {
    color: var(--fg-faint, #888);
  }
  .details-list dd {
    margin: 0;
    font-weight: 500;
  }
  .sidebar-actions {
    display: grid;
    gap: 0.75rem;
  }
  .sidebar-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }

  .project-gallery { margin-top: 3rem; }
  .gallery-title { font-size: 1.25rem; margin-bottom: 1rem; }
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .gallery-grid figure { margin: 0; }
  .gallery-grid :global(img) {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .gallery-grid figcaption {
    font-size: 0.85rem;
    color: var(--fg-muted, #666);
    margin-top: 0.5rem;
  }

  .next-project {
    margin-top: 4rem;
    padding-block: 3rem;
    border-top: 1px solid var(--border, #e5e5e5);
  }
  .next-project-link {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  .next-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint, #888);
  }
  .next-title {
    font-size: 1.5rem;
    font-weight: 600;
  }
  .next-project-link:hover .next-title {
    color: var(--accent, #4f46e5);
  }
</style>